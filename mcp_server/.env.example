# VS Code Models Configuration (Uses built-in VS Code language models and embeddings)
# USE_VSCODE_MODELS=true
# Note: VS Code models now include both LLM and embedding capabilities!
# No external API keys needed for basic functionality.

# Google Gemini Configuration (Default)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Override default models
# MODEL_NAME=gemini-2.0-flash
# SMALL_MODEL_NAME=gemini-2.5-flash-lite-preview-06-17
# EMBEDDER_MODEL_NAME=embedding-001

# Optional: LLM Temperature (0.0-2.0)
# LLM_TEMPERATURE=0.0

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Optional: Concurrency limit (decrease if getting 429 rate limit errors)
# SEMAPHORE_LIMIT=10

# Alternative: OpenAI Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL_NAME=gpt-4o-mini
# SMALL_MODEL_NAME=gpt-4o-mini
# EMBEDDER_MODEL_NAME=text-embedding-3-small

# Alternative: Azure OpenAI Configuration
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-01
# OPENAI_API_KEY=your_azure_api_key_here
# 
# For embeddings (if using different Azure endpoint):
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=your-embedding-deployment
# AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
# AZURE_OPENAI_EMBEDDING_API_KEY=your_azure_embedding_api_key_here
